{
  "compilerOptions": {
    "jsx": "react",
    "module": "commonjs",
    "target": "es6",
    "outDir": "build",
    "lib": [
      "es6",
      "dom"
    ],
    "sourceMap": true,
    "esModuleInterop": true,
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "buildSrc",
    "masterThemes",
    ".vscode-test"
  ]
}
